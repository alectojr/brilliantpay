# Set these values in your local environment; never commit real credentials.
BRILLIANTPAY_ENV=development
# Generate a persistent local key and set it outside source control.
# BRILLIANTPAY_SECRET_KEY=<unique-random-secret>
# BRILLIANTPAY_DATABASE_URL=postgresql://<user>:<password>@<host>/<database>
# BRILLIANTPAY_UPLOAD_FOLDER=<absolute-upload-directory>
# BRILLIANTPAY_ADMIN_USERNAME=<first-admin-username>
# BRILLIANTPAY_ADMIN_EMAIL=<first-admin-email>
# BRILLIANTPAY_ADMIN_PASSWORD=<strong-unique-password>
PORT=5000
BRILLIANTPAY_DEBUG=0
